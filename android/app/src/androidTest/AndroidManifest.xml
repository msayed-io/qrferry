<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Test APK only; the provider also checks the caller UID in code. -->
        <provider android:name="com.msayed.qrferry.local.UnknownLengthProvider"
            android:authorities="com.msayed.qrferry.test.unknown"
            android:exported="true" />
        <provider android:name="com.msayed.qrferry.local.TestDocumentsProvider"
            android:authorities="com.msayed.qrferry.test.documents"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>
