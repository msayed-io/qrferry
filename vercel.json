{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(scan|bridge|pc|tv|history|privacy|share)", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/asset-manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
