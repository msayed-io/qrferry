{
  "name": "qrferry",
  "version": "1.2.28",
  "private": true,
  "license": "MIT",
  "description": "انقل ملفاً بين جهازين عبر بثّ أكواد QR متحرك — دون شبكة ودون خوادم.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-precache.mjs && rm -rf www && cp -R dist www",
    "start": "vite preview --host 0.0.0.0 -p 3000",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern www --ignore-pattern .next",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "test:release": "node --import tsx scripts/make-e2e-fixture.ts && playwright test",
    "test:routes": "node --test tests/rendered-html.test.mjs",
    "postinstall": "node scripts/patch-glisse.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@raptorqr/core": "0.1.1",
    "@raptorqr/fast-qr-wasm": "0.1.1",
    "@raptorqr/raptorq-wasm": "0.1.1",
    "brotli-wasm": "3.0.1",
    "fflate": "^0.8.3",
    "glisse": "0.5.0",
    "lucide-react": "^0.454.0",
    "peerjs": "^1.5.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zxing-wasm": "3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "9.39.4",
    "peer": "^1.0.2",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "type": "module"
}
